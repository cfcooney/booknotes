<PrimaryButton@Button>:
    size_hint_y: None
    height: "44dp"
    color: 1, 1, 1, 1
    background_color: 0, 0, 0, 0
    background_normal: ""
    background_down: ""
    canvas.before:
        Color:
            rgba: (0.176, 0.314, 0.251, 1) if self.state == 'down' else (0.239, 0.420, 0.341, 1)
        RoundedRectangle:
            size: self.size
            pos: self.pos
            radius: [6]

<SecondaryButton@Button>:
    size_hint_y: None
    height: "44dp"
    color: 0.239, 0.420, 0.341, 1
    background_color: 0, 0, 0, 0
    background_normal: ""
    background_down: ""
    canvas.before:
        Color:
            rgba: (0.87, 0.85, 0.82, 1) if self.state == 'down' else (0.937, 0.925, 0.902, 1)
        RoundedRectangle:
            size: self.size
            pos: self.pos
            radius: [6]

<ScreenTitle@Label>:
    font_size: "20sp"
    bold: True
    color: 1, 1, 1, 1

<FieldLabel@Label>:
    size_hint_y: None
    height: "20dp"
    font_size: "12sp"
    color: 0.42, 0.40, 0.38, 1
    halign: "left"
    valign: "middle"
    text_size: self.size

