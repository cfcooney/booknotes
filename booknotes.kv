#:kivy 2.3.1

<HomeScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: "20dp"
        spacing: "12dp"

        Label:
            text: "Book Notes"
            font_size: "28sp"
            bold: True
            size_hint_y: None
            height: "48dp"

        Label:
            text: "Capture ideas, quotes, and references while you read."
            text_size: self.width, None
            halign: "left"
            valign: "middle"
